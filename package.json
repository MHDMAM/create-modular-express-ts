{
  "name": "create-modular-express-ts",
  "version": "0.1.0",
  "description": "Scaffold a new modular-express-ts project: npm create modular-express-ts",
  "type": "module",
  "bin": {
    "create-modular-express-ts": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "create",
    "express",
    "typescript",
    "template",
    "scaffold"
  ],
  "author": "MHD Abdulkarim Al Midani",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MHDMAM/create-modular-express-ts.git"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . --ignore-path .gitignore",
    "test": "node --test test/*.test.ts",
    "test:e2e": "npm run build && node --test test/e2e/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "giget": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  }
}
